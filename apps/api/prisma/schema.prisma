generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}
model Category {
  id        String    @id @default(cuid())
  name      String    @unique
  active    Boolean   @default(true)
  parentId  String?
  parent    Category? @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Restrict)
  children  Category[] @relation("CategoryTree")
  products  Product[]
  lastProductSerial Int @default(0)
  createdAt DateTime  @default(now())
}
model Product {
  id          String    @id @default(cuid())
  sku         String    @unique
  name        String
  description String?
  categoryId  String
  category    Category  @relation(fields: [categoryId], references: [id])
  costPrice   Decimal   @db.Decimal(12,2)
  salePrice   Decimal   @db.Decimal(12,2)
  archived    Boolean   @default(false)
  active      Boolean   @default(true)
  serialNumber Int      @default(0)
  image        ProductImage?
  variants    Variant[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  @@unique([categoryId, serialNumber])
}

model ProductImage {
  productId String  @id
  product   Product @relation(fields: [productId], references: [id], onDelete: Restrict)
  mimeType  String
  content   Bytes
}
model Variant {
  id           String   @id @default(cuid())
  sku          String   @unique
  productId    String
  product      Product  @relation(fields: [productId], references: [id])
  size         String
  color        String
  availableQty Int      @default(0)
  reorderPoint Int      @default(5)
  reservedQty Int @default(0)
  salesItems SalesItem[]
  purchaseItems PurchaseItem[]
  movements StockMovement[]
  @@unique([productId,size,color])
}

enum MovementType {
  OPENING
  RECEIPT
  STOCK_IN
  STOCK_OUT
  RETURN_IN
  RETURN_TO_SUPPLIER
  DAMAGE
  ADJUSTMENT
}

model Supplier {
  id          String          @id @default(cuid())
  company     String
  contactName String?
  email       String?
  phone       String?
  address     String?
  taxNumber   String?
  active      Boolean         @default(true)
  createdAt   DateTime        @default(now())
  orders      PurchaseOrder[]
}

model PurchaseOrder {
  id          String          @id @default(cuid())
  reference   String          @unique
  orderDate   DateTime        @db.Date
  supplierId  String
  supplier    Supplier        @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  supplierName String
  createdAt   DateTime        @default(now())
  items       PurchaseItem[]
  receipts    GoodsReceipt[]
}

model PurchaseItem {
  id          String          @id @default(cuid())
  orderId     String
  order       PurchaseOrder   @relation(fields: [orderId], references: [id], onDelete: Restrict)
  variantId   String
  variant     Variant         @relation(fields: [variantId], references: [id], onDelete: Restrict)
  variantSku  String
  productName String
  size        String
  color       String
  quantity    Int
  receivedQty Int             @default(0)
  unitPrice   Decimal         @db.Decimal(12, 2)
  lines       ReceiptLine[]

  @@unique([orderId, variantId])
  @@index([variantId])
}

model GoodsReceipt {
  id          String          @id @default(cuid())
  reference   String          @unique
  orderId     String
  order       PurchaseOrder   @relation(fields: [orderId], references: [id], onDelete: Restrict)
  receivedAt  DateTime        @default(now())
  lines       ReceiptLine[]

  @@index([orderId])
}

model ReceiptLine {
  id          String        @id @default(cuid())
  receiptId   String
  receipt     GoodsReceipt  @relation(fields: [receiptId], references: [id], onDelete: Restrict)
  itemId      String
  item        PurchaseItem  @relation(fields: [itemId], references: [id], onDelete: Restrict)
  quantity    Int
  movement    StockMovement?

  @@unique([receiptId, itemId])
  @@index([itemId])
}

model StockMovement {
  id            String       @id @default(cuid())
  variantId     String
  variant       Variant      @relation(fields: [variantId], references: [id], onDelete: Restrict)
  type          MovementType
  quantity      Int
  balanceAfter  Int
  reason        String?
  destination   String?
  reference     String?
  requestKey    String?      @unique
  receiptLineId String?      @unique
  receiptLine   ReceiptLine? @relation(fields: [receiptLineId], references: [id], onDelete: Restrict)
  createdAt     DateTime     @default(now())

  @@index([variantId, createdAt])
  @@index([createdAt, id])
}

enum CustomerType {
  CUSTOMER
  SHOP
  WHOLESALE
}

enum SalesStatus {
  DRAFT
  CONFIRMED
  PARTIALLY_DISPATCHED
  DISPATCHED
  CANCELLED
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
}

enum ReturnCondition {
  SALEABLE
  DAMAGED
}

model Customer {
  id String @id @default(cuid())
  businessName String
  type CustomerType
  contactName String?
  email String?
  phone String?
  address String?
  creditLimit Decimal @default(0) @db.Decimal(16, 2)
  creditDays Int @default(0)
  archived Boolean @default(false)
  createdAt DateTime @default(now())
  orders SalesOrder[]
}

model SalesOrder {
  pendingRefund Decimal @default(0) @db.Decimal(24, 2)
  id String @id @default(cuid())
  number String @unique
  customerId String
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)
  customerName String
  customerContact String?
  customerEmail String?
  customerPhone String?
  customerAddress String?
  status SalesStatus @default(DRAFT)
  reserveStock Boolean @default(true)
  dueDate DateTime @db.Date
  subtotal Decimal @db.Decimal(24, 2)
  total Decimal @db.Decimal(24, 2)
  billed Decimal @default(0) @db.Decimal(24, 2)
  credited Decimal @default(0) @db.Decimal(24, 2)
  paid Decimal @default(0) @db.Decimal(24, 2)
  refunded Decimal @default(0) @db.Decimal(24, 2)
  createdAt DateTime @default(now())
  items SalesItem[]
  dispatches SalesDispatch[]
  payments SalesPayment[]
  returns SalesReturn[]
  events SalesEvent[]

  @@index([customerId])
  @@index([createdAt])
}

model SalesItem {
  id String @id @default(cuid())
  orderId String
  order SalesOrder @relation(fields: [orderId], references: [id], onDelete: Restrict)
  variantId String
  variant Variant @relation(fields: [variantId], references: [id], onDelete: Restrict)
  variantSku String
  productName String
  size String
  color String
  quantity Int
  dispatched Int @default(0)
  returned Int @default(0)
  unitPrice Decimal @db.Decimal(16, 2)
  unitCost  Decimal? @db.Decimal(12, 2)
  discount Decimal @db.Decimal(24, 2)
  total Decimal @db.Decimal(24, 2)
  dispatchLines SalesDispatchLine[]
  returnLines SalesReturnLine[]

  @@unique([orderId, variantId])
  @@index([variantId])
}

model SalesDispatch {
  issuer Json?
  id String @id @default(cuid())
  orderId String
  order SalesOrder @relation(fields: [orderId], references: [id], onDelete: Restrict)
  reference String @unique
  requestKey String @unique
  destination String
  total Decimal @db.Decimal(24, 2)
  createdAt DateTime @default(now())
  lines SalesDispatchLine[]

  @@index([orderId])
}

model SalesDispatchLine {
  id String @id @default(cuid())
  dispatchId String
  dispatch SalesDispatch @relation(fields: [dispatchId], references: [id], onDelete: Restrict)
  itemId String
  item SalesItem @relation(fields: [itemId], references: [id], onDelete: Restrict)
  quantity Int
  amount Decimal @db.Decimal(24, 2)

  @@unique([dispatchId, itemId])
}

model SalesPayment {
  id String @id @default(cuid())
  orderId String
  order SalesOrder @relation(fields: [orderId], references: [id], onDelete: Restrict)
  reference String @unique
  requestKey String @unique
  method PaymentMethod
  amount Decimal @db.Decimal(24, 2)
  createdAt DateTime @default(now())

  @@index([orderId])
}

model SalesReturn {
  refundDue Decimal @default(0) @db.Decimal(24, 2)
  settlements RefundSettlement[]
  id String @id @default(cuid())
  orderId String
  order SalesOrder @relation(fields: [orderId], references: [id], onDelete: Restrict)
  reference String @unique
  requestKey String @unique
  reason String
  credit Decimal @db.Decimal(24, 2)
  refunded Decimal @db.Decimal(24, 2)
  refundMethod PaymentMethod?
  createdAt DateTime @default(now())
  lines SalesReturnLine[]

  @@index([orderId])
}

model SalesReturnLine {
  id String @id @default(cuid())
  returnId String
  saleReturn SalesReturn @relation(fields: [returnId], references: [id], onDelete: Restrict)
  itemId String
  item SalesItem @relation(fields: [itemId], references: [id], onDelete: Restrict)
  quantity Int
  condition ReturnCondition
  credit Decimal @db.Decimal(24, 2)

  @@unique([returnId, itemId])
}

model SalesEvent {
  id String @id @default(cuid())
  orderId String
  order SalesOrder @relation(fields: [orderId], references: [id], onDelete: Restrict)
  action String
  reference String?
  createdAt DateTime @default(now())

  @@index([orderId, createdAt])
}

model ActivityLog {
  actorId   String?
  actorName String?
  id        BigInt   @id @default(autoincrement())
  createdAt DateTime @default(dbgenerated("clock_timestamp()")) @db.Timestamptz(6)
  area      String
  action    String
  entityId  String
  reference String

  @@index([createdAt, id])
  @@index([area, createdAt])
}

enum StaffRole {
  ADMIN
  WAREHOUSE
  SALES
  FINANCE
}

model StaffUser {
  id           String         @id @default(cuid())
  username     String         @unique
  displayName  String
  passwordHash String
  role         StaffRole
  active       Boolean        @default(true)
  createdAt    DateTime       @default(now())
  sessions     StaffSession[]
  permissions  Json?
  resetHash    String? @unique
  resetExpires DateTime?
  signupPending Boolean @default(false)
  branchOnly Boolean @default(false)
  branchAccess BranchAccess[]

  @@index([signupPending, createdAt])
}

model StaffSession {
  tokenHash String    @id
  userId    String
  user      StaffUser @relation(fields: [userId], references: [id], onDelete: Restrict)
  expiresAt DateTime
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model BusinessSettings {
  id            String @id
  companyName   String @default("GarmentPro")
  address       String @default("")
  phone         String @default("")
  email         String @default("")
  invoiceFooter String @default("")
  invoiceLogo String?
  invoiceLogoPlacement String @default("HEADER")
  invoiceTimeZone String @default("Asia/Karachi")
}

model RefundSettlement {
  id         String        @id @default(cuid())
  returnId   String
  salesReturn SalesReturn   @relation(fields: [returnId], references: [id], onDelete: Restrict)
  reference  String        @unique
  requestKey String        @unique
  method     PaymentMethod
  amount     Decimal       @db.Decimal(24, 2)
  createdAt  DateTime      @default(now())

  @@index([returnId])
  @@index([createdAt])
}

model Shop {
  id String @id @default(cuid())
  name String @unique
  branches Branch[]
}

model Branch {
  id String @id @default(cuid())
  shopId String
  shop Shop @relation(fields: [shopId], references: [id], onDelete: Restrict)
  name String
  schemaName String @unique
  ready Boolean @default(false)
  access BranchAccess[]

  @@unique([shopId, name])
}

model BranchAccess {
  branchId String
  branch Branch @relation(fields: [branchId], references: [id], onDelete: Restrict)
  userId String
  user StaffUser @relation(fields: [userId], references: [id], onDelete: Restrict)
  permissions String[]
  manager Boolean @default(false)

  @@id([branchId, userId])
  @@index([userId])
}