{
  "name": "garmentpro-starter",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently -n API,WEB -c green,blue \"npm run dev -w apps/api\" \"npm run dev -w apps/web\"",
    "build": "npm run build -w apps/api && npm run build -w apps/web",
    "db:migrate:all": "npm run db:migrate:all -w apps/api",
    "db:generate": "npm run db:generate -w apps/api",
    "db:migrate": "npm run db:migrate -w apps/api",
    "db:seed": "npm run db:seed -w apps/api",
    "test": "npm run test -w apps/api",
    "auth:bootstrap": "npm run auth:bootstrap -w apps/api"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
